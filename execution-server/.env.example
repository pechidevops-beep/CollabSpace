# ==============================================================================
# CollabSpace Execution Server Environment Configuration (.env.example)
# Copy this file to .env in execution-server/ for local development.
# ==============================================================================

# ── Server & CORS ─────────────────────────────────────────────────────────────
# Port the execution server listens on (default: 4000)
PORT=4000
# Node environment ('development', 'test', 'production')
NODE_ENV=development
# Comma-separated list of browser origins permitted to call the execution server
CORS_ORIGIN=http://localhost:5173
# Maximum JSON request body size allowed (default: 2mb)
BODY_LIMIT=2mb

# ── Supabase Authentication ───────────────────────────────────────────────────
# Base URL of your Supabase instance (used for token verification & JWKS)
SUPABASE_URL=http://127.0.0.1:54321
# Supabase anonymous API key for server-to-Supabase REST fallback
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJpYXQiOjE3MDk3MjAwMDAsImV4cCI6MjAyNTI5NjAwMH0.test-anon-key-local-collabspace
# Supabase JWT Secret for fast local HS256 verification (found in Supabase Settings > API)
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-in-it
# Optional: JWKS endpoint for asymmetric JWT verification (default: <SUPABASE_URL>/auth/v1/.well-known/jwks.json)
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
# Optional: Verification mode override ('secret', 'jwks', or 'supabase_api')
JWT_AUTH_MODE=secret
# Expected JWT audience claim (default: authenticated)
SUPABASE_JWT_AUDIENCE=authenticated
# Optional expected JWT issuer claim
# SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
# Strict test auth bypass: Only permitted when NODE_ENV === 'test'
ALLOW_TEST_AUTH=false

# ── Docker Sandbox Configuration ──────────────────────────────────────────────
# Docker image tag for compiling and running Java code (built via npm run docker:build)
JAVA_IMAGE=collabspace-java
# Docker image tag for running Python code (built via npm run docker:build)
PYTHON_IMAGE=collabspace-python
# Non-root user inside container for sandboxed process execution (default: sandbox)
CONTAINER_USER=sandbox
# Memory limit for Java containers (includes tmpfs; default: 512m)
JAVA_MEMORY_LIMIT=512m
# Memory limit for Python containers (default: 128m)
PYTHON_MEMORY_LIMIT=128m
# Maximum CPU cores allocated per container (default: 0.5)
CPU_LIMIT=0.5
# Maximum process and thread count to prevent fork bombs (default: 64)
PIDS_LIMIT=64
# Compilation timeout deadline in milliseconds (default: 15000 = 15s)
COMPILE_TIMEOUT_MS=15000
# Program execution timeout deadline in milliseconds (default: 10000 = 10s)
RUN_TIMEOUT_MS=10000
# Grace margin before container reaper terminates orphaned containers (default: 30000 = 30s)
REAP_MARGIN_MS=30000
# Output soft cap in bytes before truncation notice is appended (default: 262144 = 256 KB)
MAX_OUTPUT_BYTES=262144
# Output hard limit in bytes that immediately terminates container (default: 1048576 = 1 MB)
HARD_OUTPUT_LIMIT_BYTES=1048576

# ── Rate Limiting & Concurrency ───────────────────────────────────────────────
# Rolling time window for per-user rate limiting in milliseconds (default: 60000 = 1m)
RATE_LIMIT_WINDOW_MS=60000
# Maximum execution requests allowed per user per window before 429 Retry-After (default: 20)
RATE_LIMIT_MAX=20
# Maximum total parallel container executions allowed server-wide (default: 4)
MAX_CONCURRENT_RUNS=4
# Maximum simultaneous runs allowed for a single user (default: 1)
MAX_USER_CONCURRENCY=1
# Maximum pending requests held in FIFO concurrency queue (default: 20)
MAX_QUEUE_SIZE=20
# Maximum time in milliseconds a request waits in queue before timing out (default: 15000 = 15s)
QUEUE_TIMEOUT_MS=15000
