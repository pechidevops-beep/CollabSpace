FROM python:3.11-slim

# ── Copy pre-downloaded Linux wheels (manylinux, no network needed) ───
COPY wheels/ /tmp/wheels/

# ── Install Python science & utility libraries from local wheels ──────
RUN pip install --no-cache-dir --no-index --find-links=/tmp/wheels \
        numpy \
        pandas \
        matplotlib \
        scipy \
        scikit-learn \
        requests \
        Pillow \
        seaborn \
        sympy \
        openpyxl \
    && rm -rf /tmp/wheels

# ── Copy Java 17 JDK (pre-downloaded on host, no network needed) ──────
COPY jdk17.tar.gz /tmp/jdk17.tar.gz
RUN mkdir -p /opt/java \
    && tar -xzf /tmp/jdk17.tar.gz -C /opt/java --strip-components=1 \
    && rm /tmp/jdk17.tar.gz

ENV JAVA_HOME=/opt/java
ENV PATH="$JAVA_HOME/bin:$PATH"

WORKDIR /workspace

CMD ["bash"]
